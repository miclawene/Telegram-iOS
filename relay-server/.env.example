# ─── Relay Server Configuration ──────────────────────────────────────────────

# Port the Node.js process listens on (nginx proxies to this)
PORT=3000

# Optional auth token.  Clients must append ?token=<AUTH_TOKEN> to the WSS URL.
# Leave empty to disable authentication (not recommended for public relays).
AUTH_TOKEN=

# Maximum number of simultaneous relay connections
MAX_CONNECTIONS=1000

# Logging verbosity: "info" | "warn" | "error"
LOG_LEVEL=info

# ─── DC Override List ─────────────────────────────────────────────────────────
# Override or add DC endpoints.  Format: "idx=host:port,idx=host:port"
# Example: DC_LIST="1=149.154.175.53:443,2=149.154.167.51:443"
DC_LIST=

# ─── Domain (used by nginx and certbot) ───────────────────────────────────────
DOMAIN=relay.example.com

# ─── Cloudflare (optional, for origin certificate) ───────────────────────────
# CF_API_TOKEN=your_cloudflare_api_token
