# ─── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database (Postgres) ──────────────────────────────────────────────────────
DATABASE_URL=postgres://workos:workos@localhost:5432/workos

# ─── Redis (pub/sub, jobs, temporary auth states) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# ─── Telegram (server-side only, NEVER in frontend bundle) ────────────────────
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── Internal service auth (backend <-> telegram-worker) ──────────────────────
# Shared secret for internal event-bus calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_INTERNAL_SECRET=

# ─── Service ports ────────────────────────────────────────────────────────────
API_PORT=4000
WORKER_PORT=4100

# ─── Backend <-> telegram-worker (internal control API, Phase 2) ──────────────
# The API reaches the worker here; the worker reads Telegram chats/history and
# sends messages. Never exposed to the browser.
WORKER_URL=http://localhost:4100
# The worker also needs DATABASE_URL (declared above) to persist/restore
# encrypted Telegram sessions. It never sends the session to the API.

# ─── Frontend (public — safe to expose) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
